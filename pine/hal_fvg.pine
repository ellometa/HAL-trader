// Mirrors backend/ict/fvg.py — 3-candle Fair Value Gap detector.
// Bullish FVG: low[0] > high[2]. Bearish FVG: high[0] < low[2].
// Geometric definition only — middle candle is not constrained.
// Mitigation: any later bar whose range overlaps the box (low <= top,
// high >= bottom).

//@version=6
indicator("HAL FVG", "HAL FVG", overlay = true, max_boxes_count = 500)

show_bull = input.bool(true,  "Bullish FVG")
show_bear = input.bool(true,  "Bearish FVG")
show_mit  = input.bool(true,  "Show mitigated zones")
col_bull  = input.color(color.new(color.green, 80), "Bullish color")
col_bear  = input.color(color.new(color.red,   80), "Bearish color")
col_mit   = input.color(color.new(color.gray,  90), "Mitigated color")

// Active (unmitigated) zones tracked in parallel arrays.
var array<box> boxes = array.new<box>()

bull_fvg = low > high[2]
bear_fvg = high < low[2]

if bull_fvg and show_bull
    bx = box.new(bar_index - 2, low, bar_index, high[2],
         bgcolor = col_bull, border_color = na)
    array.push(boxes, bx)

if bear_fvg and show_bear
    bx = box.new(bar_index - 2, low[2], bar_index, high,
         bgcolor = col_bear, border_color = na)
    array.push(boxes, bx)

// Extend right edge + check mitigation. Iterate backwards so removals
// don't disturb earlier indices.
if array.size(boxes) > 0
    i = array.size(boxes) - 1
    while i >= 0
        bx = array.get(boxes, i)
        box.set_right(bx, bar_index)
        top = box.get_top(bx)
        bot = box.get_bottom(bx)
        // Mitigation gated on "past the formation bar" — box's right was the
        // detection bar; mitigation kicks in from the next bar onwards.
        if bar_index > box.get_left(bx) + 2
            if low <= top and high >= bot
                if show_mit
                    box.set_bgcolor(bx, col_mit)
                else
                    box.delete(bx)
                array.remove(boxes, i)
        i := i - 1
